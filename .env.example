# Meta WhatsApp Cloud API Configuration
# Copy this to .env and fill in your actual values

# Meta WhatsApp Business Account ID (from Meta Business Manager)
META_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# WhatsApp Phone Number ID (from WhatsApp Manager)
META_PHONE_NUMBER_ID=your_phone_number_id_here

# Access Token (from Facebook Developers)
META_ACCESS_TOKEN=your_access_token_here

# Meta WhatsApp API Version
META_WHATSAPP_API_VERSION=v18.0
